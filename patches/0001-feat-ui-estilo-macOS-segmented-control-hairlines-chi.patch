diff --git a/frontend/src/estilos.css b/frontend/src/estilos.css
index f6b087b..a071ab7 100644
--- a/frontend/src/estilos.css
+++ b/frontend/src/estilos.css
@@ -1,11 +1,315 @@
-/* ============================================================
+﻿/* ============================================================
    ESTILOS VISUALES ALTERNATIVOS
    Se activan con <html data-estilo="...">.
    El estilo "limpio" no tiene reglas: es el index.css base.
    ============================================================ */
 
 /* ------------------------------------------------------------
-   1) VISION GLASS — vidrio fuerte + aurora de fondo
+   1) macOS — system style de Apple
+   Tipografía del sistema, hairlines, segmented control,
+   chips pastel con texto oscuro.
+   ------------------------------------------------------------ */
+[data-estilo="macos"][data-tema] {
+  --bg: #12151b;
+  --bg-surface: #1a1e26;
+  --bg-card: #222834;
+  --bg-refuerzo: #2c3342;
+  --text: #f2f4f8;
+  --text-muted: #8b93a5;
+  --primary: #0a84ff;
+  --primary-hover: #409cff;
+  --primary-suave: rgba(10, 132, 255, .18);
+  --border: rgba(255, 255, 255, .09);
+  --border-suave: rgba(255, 255, 255, .055);
+  --danger: #ff453a;
+  --success: #32d74b;
+  --success-suave: rgba(50, 215, 75, .16);
+  --aviso: #ffd60a;
+  --vidro: rgba(26, 30, 38, .78);
+  --modal-fondo: rgba(0, 0, 0, .5);
+  --sombra: 0 1px 2px rgba(0, 0, 0, .35), 0 10px 30px rgba(0, 0, 0, .45);
+  --sombra-suave: 0 1px 2px rgba(0, 0, 0, .3);
+}
+
+[data-estilo="macos"][data-tema="claro"] {
+  --bg: #f5f5f7;
+  --bg-surface: #ffffff;
+  --bg-card: #ffffff;
+  --bg-refuerzo: #ececf0;
+  --text: #1d1d1f;
+  --text-muted: #6e6e73;
+  --primary: #007aff;
+  --primary-hover: #0062cc;
+  --primary-suave: rgba(0, 122, 255, .10);
+  --border: rgba(0, 0, 0, .09);
+  --border-suave: rgba(0, 0, 0, .055);
+  --danger: #ff3b30;
+  --success: #34c759;
+  --success-suave: rgba(52, 199, 89, .12);
+  --aviso: #ff9500;
+  --vidro: rgba(255, 255, 255, .8);
+  --modal-fondo: rgba(0, 0, 0, .28);
+  --sombra: 0 1px 2px rgba(0, 0, 0, .06), 0 10px 30px rgba(0, 0, 0, .10);
+  --sombra-suave: 0 1px 2px rgba(0, 0, 0, .06);
+}
+
+[data-estilo="macos"] {
+  --fuente-sistema: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI Variable Text", "Segoe UI", system-ui, sans-serif;
+  --fuente-display: "SF Pro Display", -apple-system, BlinkMacSystemFont, "Segoe UI Variable Display", "Segoe UI", system-ui, sans-serif;
+}
+[data-estilo="macos"] body {
+  font-family: var(--fuente-sistema);
+  -webkit-font-smoothing: antialiased;
+  letter-spacing: -0.01em;
+}
+
+/* Titulares con la métrica de Apple: grande y de peso medio */
+[data-estilo="macos"] h1, [data-estilo="macos"] h2, [data-estilo="macos"] h3 { font-family: var(--fuente-display); }
+[data-estilo="macos"] .mes-nav h2 {
+  font-size: 1.375rem; font-weight: 600;
+  letter-spacing: -0.022em;
+}
+[data-estilo="macos"] .app-header h1 { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.02em; }
+[data-estilo="macos"] .card-titulo { font-size: 0.9375rem; font-weight: 600; letter-spacing: -0.015em; }
+[data-estilo="macos"] .modal-titulo { font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.02em; }
+[data-estilo="macos"] .evento-card-titulo { font-weight: 600; letter-spacing: -0.015em; }
+[data-estilo="macos"] .login-card h1 { font-size: 1.5rem; font-weight: 600; letter-spacing: -0.025em; }
+
+/* Trazo más fino: la elegancia de Apple está en el grosor del icono */
+[data-estilo="macos"] svg { stroke-width: 1.6; }
+[data-estilo="macos"] .cierre-check svg,
+[data-estilo="macos"] .evento-check svg { stroke-width: 2.4; }
+
+/* Radios de sistema: 10px componentes, 12px tarjetas, 16px paneles */
+[data-estilo="macos"] .ajustes-card,
+[data-estilo="macos"] .evento-card,
+[data-estilo="macos"] .nota-item,
+[data-estilo="macos"] .stat-caja,
+[data-estilo="macos"] .semana-bloque,
+[data-estilo="macos"] .bloque-url,
+[data-estilo="macos"] .resumen-texto,
+[data-estilo="macos"] .descripcion-moodle {
+  border-radius: 12px;
+  border: 1px solid var(--border-suave);
+  box-shadow: var(--sombra-suave);
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+[data-estilo="macos"] .ajustes-card { background: var(--bg-card); }
+[data-estilo="macos"] .modal-card { border-radius: 16px; box-shadow: var(--sombra); border-color: var(--border); }
+[data-estilo="macos"] .login-card { border-radius: 16px; box-shadow: var(--sombra); }
+[data-estilo="macos"] .toast { border-radius: 11px; box-shadow: var(--sombra); }
+
+/* Cabecera y barras: solo un hairline, sin bloques de color */
+[data-estilo="macos"] .app-header,
+[data-estilo="macos"] .filtros-bar,
+[data-estilo="macos"] .mes-nav {
+  background: var(--vidro);
+  backdrop-filter: blur(20px) saturate(1.8);
+  -webkit-backdrop-filter: blur(20px) saturate(1.8);
+  border-bottom: 1px solid var(--border-suave);
+}
+[data-estilo="macos"] .user-badge {
+  font-size: 0.6875rem; font-weight: 500;
+  background: var(--bg-refuerzo);
+  color: var(--text-muted);
+  border-radius: 5px;
+  padding: 2px 7px;
+}
+
+/* SEGMENTED CONTROL — el sello de Apple en las pestañas de vista */
+[data-estilo="macos"] .view-tabs {
+  gap: 0.125rem;
+  display: flex;
+  width: fit-content;
+  margin: 10px 16px 0;
+  padding: 2px;
+  background: var(--bg-card);
+  border: 1px solid var(--border-suave);
+  border-radius: 9px;
+}
+[data-estilo="macos"] .view-tab {
+  font-size: 0.8125rem;
+  flex: 0 0 auto;
+  padding: 4px 12px;
+  border-radius: 7px;
+  border: none;
+  background: transparent;
+  color: var(--text-muted);
+  font-weight: 500;
+}
+[data-estilo="macos"] .view-tab.active {
+  background: color-mix(in srgb, var(--text) 14%, var(--bg-card));
+  color: var(--text);
+  box-shadow: var(--sombra-suave);
+}
+[data-estilo="macos"] .filtros-bar { margin-top: 8px; border-top: none; }
+
+/* Chips pastel con texto oscuro, como las notas adhesivas de la captura */
+[data-estilo="macos"] .chip-modulo,
+[data-estilo="macos"] .cierre-chip,
+[data-estilo="macos"] .dia-evento-mini,
+[data-estilo="macos"] .celda-evento {
+  background: color-mix(in srgb, var(--tinte) 30%, #f2f5fa);
+  color: #14171d;
+  border: 1px solid color-mix(in srgb, var(--tinte) 42%, transparent);
+  font-weight: 600;
+  text-shadow: none;
+}
+[data-estilo="macos"] .dia-evento-mini,
+[data-estilo="macos"] .celda-evento { border-radius: 5px; }
+
+[data-estilo="macos"] .filtro-chip {
+  border: 1px solid var(--border);
+  background: transparent;
+  color: var(--text-muted);
+  font-weight: 500;
+  border-radius: 7px;
+}
+[data-estilo="macos"] .filtro-chip:hover { background: var(--bg-card); color: var(--text); }
+[data-estilo="macos"] .filtro-chip.active {
+  background: color-mix(in srgb, var(--tinte, var(--primary)) 20%, var(--bg-card));
+  color: var(--text);
+  border-color: color-mix(in srgb, var(--tinte, var(--primary)) 45%, transparent);
+}
+
+/* Calendario: rejilla casi invisible, hoy como punto de sistema */
+[data-estilo="macos"] .calendario-grid { border-color: var(--border-suave); }
+[data-estilo="macos"] .dia-celda,
+[data-estilo="macos"] .dia-cabecera { border-color: var(--border-suave); }
+[data-estilo="macos"] .dia-cabecera { background: transparent; font-weight: 500; }
+[data-estilo="macos"] .dia-celda:hover { background: color-mix(in srgb, var(--text) 5%, transparent); }
+[data-estilo="macos"] .dia-numero { color: var(--text-muted); font-weight: 500; font-variant-numeric: tabular-nums; }
+[data-estilo="macos"] .dia-celda.hoy .dia-numero {
+  background: var(--primary);
+  color: #fff;
+  font-weight: 600;
+}
+
+/* Botones del sistema */
+[data-estilo="macos"] .btn,
+[data-estilo="macos"] .btn-icon,
+[data-estilo="macos"] .mes-nav button,
+[data-estilo="macos"] .opcion-tema {
+  border-radius: 8px;
+  border: 1px solid var(--border);
+  background: var(--bg-card);
+  color: var(--text);
+  font-weight: 500;
+  box-shadow: none;
+}
+[data-estilo="macos"] .btn:hover,
+[data-estilo="macos"] .btn-icon:hover,
+[data-estilo="macos"] .mes-nav button:hover { background: var(--bg-refuerzo); }
+[data-estilo="macos"] .btn-filled,
+[data-estilo="macos"] .btn-moodle,
+[data-estilo="macos"] .login-card .btn-primary,
+[data-estilo="macos"] .opcion-tema.activo {
+  background: var(--primary);
+  border-color: transparent;
+  color: #fff;
+  font-weight: 600;
+}
+[data-estilo="macos"] .btn-filled:hover,
+[data-estilo="macos"] .btn-moodle:hover { background: var(--primary-hover); }
+[data-estilo="macos"] .btn-danger { background: transparent; border-color: color-mix(in srgb, var(--danger) 45%, transparent); color: var(--danger); }
+[data-estilo="macos"] .btn-danger:hover { background: color-mix(in srgb, var(--danger) 14%, transparent); filter: none; }
+
+[data-estilo="macos"] .fab {
+  border-radius: 999px;
+  background: var(--primary);
+  box-shadow: 0 4px 14px rgba(0, 0, 0, .3), 0 0 0 1px color-mix(in srgb, #fff 12%, transparent) inset;
+}
+[data-estilo="macos"] .fab:hover { background: var(--primary-hover); transform: none; }
+
+/* Inputs: fondo hundido suave, foco de sistema */
+[data-estilo="macos"] .modal-body input,
+[data-estilo="macos"] .modal-body textarea,
+[data-estilo="macos"] .modal-body select,
+[data-estilo="macos"] .nota-input,
+[data-estilo="macos"] .login-card input {
+  border-radius: 8px;
+  border: 1px solid var(--border);
+  background: color-mix(in srgb, var(--bg) 65%, var(--bg-surface));
+}
+[data-estilo="macos"] .modal-body input:focus,
+[data-estilo="macos"] .modal-body textarea:focus,
+[data-estilo="macos"] .modal-body select:focus,
+[data-estilo="macos"] .nota-input:focus,
+[data-estilo="macos"] .login-card input:focus {
+  border-color: var(--primary);
+  box-shadow: 0 0 0 3.5px color-mix(in srgb, var(--primary) 26%, transparent);
+  outline: none;
+}
+[data-estilo="macos"] .modal-body label,
+[data-estilo="macos"] .login-card label {
+  font-weight: 500;
+  text-transform: none;
+  letter-spacing: 0;
+  font-size: 0.75rem;
+}
+
+/* Listas y detalles */
+[data-estilo="macos"] .evento-card { background: var(--bg-card); }
+[data-estilo="macos"] .evento-card:hover { background: var(--bg-refuerzo); border-color: var(--border-suave); }
+[data-estilo="macos"] .evento-card-color { width: 3px; border-radius: 2px; opacity: .85; }
+[data-estilo="macos"] .evento-check { border-radius: 5px; }
+[data-estilo="macos"] .grupo-hoy { color: var(--primary); }
